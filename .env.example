# Supabase — Settings → API (or Connect). Use your project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Public client key (pick one — same role as the legacy "anon" key):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — for `npm run db:migrate` only (Postgres URI from Dashboard → Database → Connection string). Do not commit real passwords.
# DATABASE_URL=postgresql://postgres.[PROJECT]:[YOUR-PASSWORD]@...
